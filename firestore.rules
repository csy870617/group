rules_version = '2';

// 교회 소그룹 편성 — Firestore 보안 규칙
//
// 이 앱은 로그인 없이 4자리 비밀번호로 방에 입장하는 구조입니다.
// 따라서 인증 기반으로 "사회자만 그룹 편성" 같은 제한을 강제하기는
// 어렵고, 대신 데이터 형식을 검증하고 불필요한 권한을 막는 수준으로
// 보호합니다. 교회 내부용 등 신뢰된 환경을 가정합니다.
//
// 더 강하게 잠그고 싶다면 Firebase Authentication(익명 로그인)을 붙여
// 방 생성자만 groups 를 수정하도록 확장할 수 있습니다.

service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{code} {
      // 누구나 방을 조회할 수 있음 (비밀번호를 알아야 code 를 알 수 있음)
      allow read: if true;

      // 방 생성: 코드가 4자리 숫자이고 문서 형식·타입이 맞아야 함
      // (트랜잭션으로 원자적으로 생성되어 동시 사용 시에도 코드가 겹치지 않음)
      allow create: if code.matches('[0-9]{4}')
                    && request.resource.data.code == code
                    && request.resource.data.keys().hasOnly(['code', 'groups', 'perGroup', 'createdAt', 'expireAt'])
                    && request.resource.data.groups == null
                    && request.resource.data.perGroup is int
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.expireAt is timestamp;

      // 방 수정: 그룹 편성, 그룹당 인원수 변경만 허용 (code 변경 불가)
      allow update: if request.resource.data.code == resource.data.code
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['groups', 'perGroup'])
                    && request.resource.data.perGroup is int
                    && (request.resource.data.groups == null
                        || request.resource.data.groups is list);

      // 방 삭제 허용 (사회자 종료 / TTL / 코드 재사용 정리 시)
      allow delete: if true;

      // 참가자 하위 컬렉션
      match /participants/{pid} {
        allow read: if true;

        // 입장: 이름(문자열, 1~30자)·성별(male/female)·입장시각만 허용
        allow create: if request.resource.data.keys().hasOnly(['name', 'gender', 'joinedAt'])
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.name.size() <= 30
                      && request.resource.data.gender in ['male', 'female']
                      && request.resource.data.joinedAt is timestamp;

        // 참가자 문서는 수정하지 않음(미사용). 퇴장/정리를 위한 삭제만 허용.
        allow update: if false;
        allow delete: if true;
      }
    }
  }
}
